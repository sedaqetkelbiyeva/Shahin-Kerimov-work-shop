    -- Çıxış parametrlərini qəbul edəcək lokal dəyişənlər
    v_balance       NUMBER;
    v_txn_count     NUMBER;
    v_last_txn_date DATE;
    v_test_acct_id  NUMBER := 118; -- Test etmək istədiyimiz Hesab ID-si
BEGIN
    -- Prosedurun çağırılması
    pr_account_summary(
        p_account_id    => v_test_acct_id,
        p_balance       => v_balance,
        p_txn_count     => v_txn_count,
        p_last_txn_date => v_last_txn_date
